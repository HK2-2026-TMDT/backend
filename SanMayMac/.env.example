# Copy to .env and fill in secrets:
#   copy .env.example .env
#
# Deploy .env to EC2 (from SanMayMac folder):
#   .\scripts\scp-env-to-ec2.ps1 -Ec2Host ec2-user@YOUR_EC2_IP -KeyPath C:\path\to\key.pem
#
# Firebase: paste service account JSON as one line into FIREBASE_SERVICE_ACCOUNT_JSON
# (do NOT commit serviceAccountKey.json — file removed from repo)

# ========================
# Spring Profile
# docker = chạy trong Docker Compose (DB host: postgres)
# local  = chạy ./gradlew bootRun trên máy (DB host: localhost)
# ========================
SPRING_PROFILES_ACTIVE=docker
SPRING_LIQUIBASE_ENABLED=true

# ========================
# PostgreSQL (local Docker)
# ========================
POSTGRES_DB=sanmaymac
POSTGRES_USER=sanmaymac
POSTGRES_PASSWORD=sanmaymac
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sanmaymac
SPRING_DATASOURCE_USERNAME=sanmaymac
SPRING_DATASOURCE_PASSWORD=sanmaymac

# BootRun trên máy:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sanmaymac

# ========================
# JWT & Auth
# ========================
JWT_SECRET=
JWT_EXPIRATION_SECONDS=604800
AUTH_VERIFY_TOKEN_EXP_MINUTES=60
AUTH_RESET_TOKEN_EXP_MINUTES=30
AUTH_REFRESH_TOKEN_EXP_MINUTES=43200
AUTH_BOOTSTRAP_ADMIN_SECRET=

# ========================
# Email (Gmail SMTP)
# ========================
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ========================
# Redis / RabbitMQ
# ========================
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# BootRun trên máy: SPRING_REDIS_HOST=localhost, SPRING_RABBITMQ_HOST=localhost

# ========================
# Storage (local | s3)
# ========================
APP_STORAGE_PROVIDER=local
APP_STORAGE_UPLOAD_DIR=uploads
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=ap-southeast-1
APP_STORAGE_S3_PREFIX=uploads
APP_STORAGE_S3_PUBLIC_BASE_URL=
APP_STORAGE_S3_ACCESS_KEY=
APP_STORAGE_S3_SECRET_KEY=

# ========================
# Firebase — JSON một dòng (từ Firebase Console → Service accounts)
# ========================
FIREBASE_SERVICE_ACCOUNT_JSON=

# ========================
# GHN Shipping
# ========================
GHN_TOKEN=
GHN_SHOP_ID=
GHN_SERVICE_TYPE_ID=2
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api

# ========================
# MoMo Payment
# ========================
MOMO_ENDPOINT=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=
MOMO_REQUEST_TYPE=captureWallet

# ========================
# Dev demo accounts (docker/local profile)
# ========================
APP_DEV_SEED_ACCOUNTS=true
